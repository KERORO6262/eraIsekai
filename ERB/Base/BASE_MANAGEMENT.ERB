; ============================================================
; BASE_MANAGEMENT.ERB
; 職責：基地協調入口 — 初始化、主選單路由、共用工具函式
; 子模組（同目錄）：
;   BASE_LIFECYCLE.ERB  — 晨間/晚間生命週期 Tick
;   BASE_UI.ERB         — HUD 與住宿 NPC 列表輸出
;   BASE_TRAIN.ERB      — 訓練室選單 + @SYS_TRAIN_APPLY
;   BASE_WORK.ERB       — 工坊選單
;   BASE_LOUNGE.ERB     — 休息室選單
;   BASE_INTERACT.ERB   — 互動系統（分派、指令、公式）
;   BASE_ROOM.ERB       — 房間管理選單 + @SYS_ROOM_MOVE_IN/OUT
; ============================================================

; ============================================================
; 初始化
; ============================================================

@BASE_INIT
CALL INIT_ROOM_OWNER
CALL INIT_WORK_QUEUE
RETURN

@INIT_ROOM_OWNER
FOR LOCAL, 0, ROOM_OWNER_MAX - 1
    ROOM_OWNER:LOCAL = -1
NEXT
FLAG:ROOM_USED = 0
RETURN

@INIT_WORK_QUEUE
FOR LOCAL, 0, WORK_Q_MAX
    WORK_Q_TYPE:LOCAL = 0
    WORK_Q_REMAIN:LOCAL = 0
NEXT
RETURN

; ============================================================
; 基地主選單路由（按鈕 100–140）
; 規範：跨域或進入設施/戰鬥一律 CALL/RETURN；
;        同模組內部 UI 刷新才可 GOTO
; ============================================================

@BASE_MENU
$BASE_MENU_TOP
CALL BASE_SYNC_DAILY_USES
DRAWLINE
CALL BASE_PRINT_HUD
DRAWLINE
PRINTL --- 住宿 NPC 狀態 ---
CALL BASE_PRINT_NPC_LIST
DRAWLINE
PRINTL [100] 訓練室
PRINTL [110] 工坊
PRINTL [120] 休息室
PRINTL [130] 房間管理
PRINTL [140] 出戰（戰前準備）
PRINTL [999] 開發者選項 (Debug Mode)
PRINTL [9] 返回日間選單
INPUT RESULT

IF RESULT == 100
    CALL BASE_TRAIN_MENU
    GOTO BASE_MENU_TOP
ENDIF
IF RESULT == 110
    CALL BASE_WORK_MENU
    GOTO BASE_MENU_TOP
ENDIF
IF RESULT == 120
    CALL BASE_LOUNGE_MENU
    GOTO BASE_MENU_TOP
ENDIF
IF RESULT == 130
    CALL BASE_ROOM_MENU
    GOTO BASE_MENU_TOP
ENDIF
IF RESULT == 140
    CALL INIT_PARTY_STATE
    CALL BATTLE_PREPARATION
    GOTO BASE_MENU_TOP
ENDIF
IF RESULT == 999
    CALL DEBUG_MAIN_MENU
    GOTO BASE_MENU_TOP
ENDIF
IF RESULT == 9
    RETURN
ENDIF

PRINTL 請輸入 100/110/120/130/140/999/9。
GOTO BASE_MENU_TOP

; ============================================================
; 每日使用次數同步（換日時自動清空）
; ============================================================

@BASE_SYNC_DAILY_USES
IF TFLAG:BASE_DAY_SYNC != FLAG:BASE_DAY
    TFLAG:BASE_DAY_SYNC = FLAG:BASE_DAY
    TFLAG:BASE_USES_TRAIN = 0
    TFLAG:BASE_USES_LOUNGE = 0
ENDIF
RETURN

; ============================================================
; 住宿 NPC 選擇器
; 契約：必須明確 RETURN RESULT，禁止空 RETURN
; RETURN >= 0 為有效 NPC ID；RETURN -1 為取消
; ============================================================

@SELECT_RESIDENT_NPC
LOCAL:20 = FLAG:BASE_FAC_LV_ROOM
IF LOCAL:20 < 0
    LOCAL:20 = 0
ELSEIF LOCAL:20 > ROOM_OWNER_MAX
    LOCAL:20 = ROOM_OWNER_MAX
ENDIF

PRINTL --- 可選擇的住宿 NPC ---
LOCAL:21 = 0
FOR LOCAL, 0, LOCAL:20
    IF ROOM_OWNER:LOCAL == -1
        CONTINUE
    ENDIF

    LOCAL:1 = ROOM_OWNER:LOCAL
    CALL GET_RACE_STR, CFLAG:(LOCAL:1):CF_RACE
    CALL GET_JOB_STR, CFLAG:(LOCAL:1):CF_JOB
    PRINTFORML [{LOCAL:1}] %CALLNAME:(LOCAL:1)% [%RESULTS:0% / %RESULTS:1%] | 好感 {CFLAG:(LOCAL:1):CF_BOND_LV} | 心情 {CFLAG:(LOCAL:1):CF_MOOD} | 疲勞 {CFLAG:(LOCAL:1):CF_FATIGUE}
    LOCAL:21 = 1
NEXT
IF LOCAL:21 == 0
    PRINTL （目前沒有住宿 NPC）
    WAIT
    RETURN -1
ENDIF

PRINTL [99] 取消
INPUT RESULT
IF RESULT == 99
    RETURN -1
ENDIF
FOR LOCAL, 0, LOCAL:20
    IF ROOM_OWNER:LOCAL == RESULT
        RETURN RESULT
    ENDIF
NEXT
PRINTL 請輸入有效的住宿 NPC 編號。
WAIT
RETURN -1

; ============================================================
; 設施升級子選單（共用）
; ARG   = 目前等級
; ARGS  = 設施名稱
; RETURN 1=升級成功 / 0=取消或資源不足
; ============================================================

@FACILITY_UPGRADE_MENU, ARG, ARGS
$FACILITY_MENU_LOOP
LOCAL = ARG
LOCAL:1 = 300 + LOCAL * 250 + LOCAL * LOCAL * 120
LOCAL:2 = 80 + LOCAL * 60 + LOCAL * LOCAL * 20

DRAWLINE
PRINTFORML 【%ARGS%】
PRINTFORML 目前等級：Lv.{LOCAL}
PRINTFORML 升級消耗：金錢 {LOCAL:1} / 材料 {LOCAL:2}
PRINTFORML 持有資源：金錢 {FLAG:RES_MONEY} / 材料 {FLAG:RES_MATERIAL}
PRINTL [1] 升級
PRINTL [9] 返回
INPUT RESULT

IF RESULT == 9
    RETURN 0
ENDIF
IF RESULT != 1
    PRINTL 請輸入 1 或 9。
    GOTO FACILITY_MENU_LOOP
ENDIF

IF FLAG:RES_MONEY < LOCAL:1
    PRINTL 金錢不足，無法升級。
    RETURN 0
ENDIF
IF FLAG:RES_MATERIAL < LOCAL:2
    PRINTL 材料不足，無法升級。
    RETURN 0
ENDIF

FLAG:RES_MONEY -= LOCAL:1
FLAG:RES_MATERIAL -= LOCAL:2
PRINTFORML %ARGS% 升級成功！
RETURN 1
