; ============================================================
; BASE_UI.ERB
; 職責：基地共用 UI 輸出函式
;   @BASE_PRINT_HUD      — Day/Phase/資源/設施等級一覽列
;   @BASE_PRINT_NPC_LIST — 住宿 NPC 槽位狀態列表
; ============================================================

@BASE_PRINT_HUD
IF FLAG:DAY_PHASE == 1
    LOCALS:0 = "晨間"
ELSEIF FLAG:DAY_PHASE == 2
    LOCALS:0 = "日間"
ELSEIF FLAG:DAY_PHASE == 3
    LOCALS:0 = "晚間"
ELSE
    LOCALS:0 = "---"
ENDIF
PRINTFORML Day {FLAG:BASE_DAY} | %LOCALS:0% | 金錢 {FLAG:RES_MONEY} | 材料 {FLAG:RES_MATERIAL} | 補給 {FLAG:RES_SUPPLY}
PRINTFORML 訓練 Lv.{FLAG:BASE_FAC_LV_TRAIN} | 工坊 Lv.{FLAG:BASE_FAC_LV_WORK} | 休息 Lv.{FLAG:BASE_FAC_LV_LOUNGE} | 房間 Lv.{FLAG:BASE_FAC_LV_ROOM} (住宿 {FLAG:ROOM_USED} 人)
RETURN

@BASE_PRINT_NPC_LIST
LOCAL:20 = FLAG:BASE_FAC_LV_ROOM
IF LOCAL:20 < 0
    LOCAL:20 = 0
ELSEIF LOCAL:20 > ROOM_OWNER_MAX
    LOCAL:20 = ROOM_OWNER_MAX
ENDIF
LOCAL:21 = 0
FOR LOCAL, 0, LOCAL:20
    IF ROOM_OWNER:LOCAL == -1
        CONTINUE
    ENDIF
    LOCAL:1 = ROOM_OWNER:LOCAL
    CALL GET_RACE_STR, CFLAG:(LOCAL:1):CF_RACE
    CALL GET_JOB_STR, CFLAG:(LOCAL:1):CF_JOB
    PRINTFORML [S{LOCAL}] %CALLNAME:(LOCAL:1)% [%RESULTS:0% / %RESULTS:1%] | 好感 {CFLAG:(LOCAL:1):CF_BOND_LV} | 心情 {CFLAG:(LOCAL:1):CF_MOOD} | 疲勞 {CFLAG:(LOCAL:1):CF_FATIGUE}
    LOCAL:21 += 1
NEXT
IF LOCAL:21 == 0
    PRINTL （目前無住宿 NPC）
ENDIF
RETURN
