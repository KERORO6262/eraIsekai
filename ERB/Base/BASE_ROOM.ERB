; ============================================================
; BASE_ROOM.ERB
; 職責：房間槽管理選單 UI 與入住/撤離單一入口
;   @BASE_ROOM_MENU     — 選單路由（由 @BASE_MENU CALL，RETURN 回主選單）
;   @SYS_ROOM_MOVE_IN   — 入住唯一入口，禁止繞過直接寫入 ROOM_OWNER 陣列
;   @SYS_ROOM_MOVE_OUT  — 撤離唯一入口，禁止繞過直接寫入 ROOM_OWNER 陣列
;   @ROOM_ASSIGN_MENU   — 空槽入住分配子選單
;   @ROOM_EVICT_MENU    — 有住宿時撤離確認子選單
; ============================================================

@BASE_ROOM_MENU
$BASE_ROOM_MENU_TOP
DRAWLINE
CALL BASE_PRINT_HUD
DRAWLINE
PRINTFORML 【房間管理 Lv.{FLAG:BASE_FAC_LV_ROOM}】
LOCAL:20 = FLAG:BASE_FAC_LV_ROOM
IF LOCAL:20 < 0
    LOCAL:20 = 0
ELSEIF LOCAL:20 > ROOM_OWNER_MAX
    LOCAL:20 = ROOM_OWNER_MAX
ENDIF
PRINTL
PRINTL --- 槽位狀態 ---
IF LOCAL:20 == 0
    PRINTL （尚未解鎖任何槽位，請先升級房間管理）
ENDIF
FOR LOCAL, 0, LOCAL:20
    IF ROOM_OWNER:LOCAL == -1
        PRINTFORML [{LOCAL + 1}] 槽位 {LOCAL + 1}：[空]
    ELSE
        LOCAL:1 = ROOM_OWNER:LOCAL
        CALL GET_RACE_STR, CFLAG:(LOCAL:1):CF_RACE
        CALL GET_JOB_STR, CFLAG:(LOCAL:1):CF_JOB
        PRINTFORML [{LOCAL + 1}] 槽位 {LOCAL + 1}：[%CALLNAME:(LOCAL:1)%] [%RESULTS:0% / %RESULTS:1%]
    ENDIF
NEXT
PRINTL
PRINTL [1~槽位上限] 選擇槽位
PRINTL [90] 升級房間管理
PRINTL [99] 返回基地選單
INPUT RESULT

IF RESULT == 99
    RETURN
ENDIF
IF RESULT == 90
    CALL FACILITY_UPGRADE_MENU, FLAG:BASE_FAC_LV_ROOM, "房間管理"
    IF RESULT == 1
        FLAG:BASE_FAC_LV_ROOM += 1
    ENDIF
    GOTO BASE_ROOM_MENU_TOP
ENDIF
IF RESULT < 1 || RESULT > LOCAL:20
    PRINTL 無效的槽位編號。
    GOTO BASE_ROOM_MENU_TOP
ENDIF

LOCAL = RESULT - 1
IF ROOM_OWNER:LOCAL == -1
    CALL ROOM_ASSIGN_MENU, LOCAL
ELSE
    CALL ROOM_EVICT_MENU, LOCAL
ENDIF
GOTO BASE_ROOM_MENU_TOP

; ============================================================
; @SYS_ROOM_MOVE_IN — 入住唯一入口
; 檢查條件 → 寫 ROOM_OWNER、ROOM_USED++、CFLAG:IS_RESIDENT
; ARG   = 槽位索引
; ARG:1 = NPC ID
; RETURN 1=成功 / 0=失敗
; ============================================================

@SYS_ROOM_MOVE_IN, ARG, ARG:1
LOCAL = ARG
LOCAL:1 = ARG:1

IF LOCAL < 0 || LOCAL >= ROOM_OWNER_MAX
    PRINTL [入住] 槽位編號無效。
    RETURN 0
ENDIF
IF ROOM_OWNER:LOCAL != -1
    PRINTL [入住] 此槽位已有人住。
    RETURN 0
ENDIF
IF CFLAG:(LOCAL:1):CF_IS_RESIDENT != 0
    PRINTL [入住] 該 NPC 已入住其他房間。
    RETURN 0
ENDIF
IF FLAG:RES_SUPPLY < 5
    PRINTL [入住] 補給不足，無法支撐新住宿 NPC（需補給 >= 5）。
    RETURN 0
ENDIF

ROOM_OWNER:LOCAL = LOCAL:1
FLAG:ROOM_USED += 1
CFLAG:(LOCAL:1):CF_IS_RESIDENT = 1
CFLAG:(LOCAL:1):CF_ROOM_SLOT = LOCAL
; EVT 120：入住；稱呼初始化必須在 KOJO_MESSAGE 之前執行
TARGET = LOCAL:1
CALL SYS_KOJO_INIT
CALL KOJO_MESSAGE, LOCAL:1, 120, LOCAL, 0
RETURN 1

; ============================================================
; @SYS_ROOM_MOVE_OUT — 撤離唯一入口
; 釋放槽位、設定撤離冷卻、更新 ROOM_USED
; ARG   = 槽位索引
; RETURN 1=成功 / 0=失敗
; ============================================================

@SYS_ROOM_MOVE_OUT, ARG
LOCAL = ARG

IF LOCAL < 0 || LOCAL >= ROOM_OWNER_MAX
    PRINTL [撤離] 槽位編號無效。
    RETURN 0
ENDIF
IF ROOM_OWNER:LOCAL == -1
    PRINTL [撤離] 此槽位無住宿 NPC。
    RETURN 0
ENDIF

LOCAL:1 = ROOM_OWNER:LOCAL  ; NPC ID

ROOM_OWNER:LOCAL = -1
IF FLAG:ROOM_USED > 0
    FLAG:ROOM_USED -= 1
ENDIF
CFLAG:(LOCAL:1):CF_IS_RESIDENT = 0
CFLAG:(LOCAL:1):CF_ROOM_SLOT = 9999
CFLAG:(LOCAL:1):CF_MOVEOUT_COOLDOWN = 3
; EVT 121：撤離（P0=原槽位索引）
CALL KOJO_MESSAGE, LOCAL:1, 121, LOCAL, 0
RETURN 1

; ============================================================
; 入住分配子選單
; ARG = 目標槽位索引
; ============================================================

@ROOM_ASSIGN_MENU, ARG
$ROOM_ASSIGN_TOP
LOCAL = ARG
PRINTFORML 【槽位 {LOCAL + 1}：入住分配】
PRINTL 可入住 NPC：
LOCAL:10 = 0

FOR LOCAL:11, 1, CHARANUM
    IF CFLAG:(LOCAL:11):CF_IS_RESIDENT != 0
        CONTINUE
    ENDIF
    CALL GET_RACE_STR, CFLAG:(LOCAL:11):CF_RACE
    CALL GET_JOB_STR, CFLAG:(LOCAL:11):CF_JOB
    PRINTFORML [{LOCAL:11}] %CALLNAME:(LOCAL:11)% [%RESULTS:0% / %RESULTS:1%]
    LOCAL:10 = 1
NEXT
IF LOCAL:10 == 0
    PRINTL （目前沒有可入住的 NPC）
    PRINTL [99] 取消
    INPUT RESULT
    RETURN
ENDIF

PRINTL [99] 取消
INPUT RESULT
IF RESULT == 99
    RETURN
ENDIF
IF RESULT < 1 || RESULT >= CHARANUM
    PRINTL 請輸入有效 NPC 編號。
    GOTO ROOM_ASSIGN_TOP
ENDIF
TARGET = RESULT
IF CFLAG:TARGET:CF_IS_RESIDENT != 0
    PRINTL 該 NPC 已經入住。
    GOTO ROOM_ASSIGN_TOP
ENDIF

CALL SYS_ROOM_MOVE_IN, LOCAL, TARGET
IF RESULT == 1
    PRINTFORML 已安排 [%CALLNAME:TARGET%] 入住槽位 {LOCAL + 1}。
ELSE
    PRINTL [入住] 指派失敗，請確認補給充足。
ENDIF
WAIT
RETURN

; ============================================================
; 撤離確認子選單
; ARG = 目標槽位索引
; ============================================================

@ROOM_EVICT_MENU, ARG
LOCAL = ARG
TARGET = ROOM_OWNER:LOCAL
CALL GET_RACE_STR, CFLAG:TARGET:CF_RACE
CALL GET_JOB_STR, CFLAG:TARGET:CF_JOB
PRINTFORML 【槽位 {LOCAL + 1}：[%CALLNAME:TARGET%] [%RESULTS:0% / %RESULTS:1%]】
PRINTL [1] 撤離
PRINTL [99] 取消
INPUT RESULT
IF RESULT != 1
    RETURN
ENDIF

CALL SYS_ROOM_MOVE_OUT, LOCAL
IF RESULT == 1
    PRINTL 已撤離。
ENDIF
WAIT
RETURN
