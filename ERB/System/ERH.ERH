; 戰鬥卡牌雙軸常數（Shape + Attribute）
; 卡牌打包格式：CARD = ATTRIBUTE * CARD_PACK_BASE + SHAPE
; 範例：[火·物理] = 1*10 + 1 = 11。0 保留為空槽，便於 UI 與 Debug 判讀。
#DEFINE CARD_PACK_BASE 10

; Shape：只用於技能配方判定
#DEFINE SHAPE_PHYS 1    ; 物理
#DEFINE SHAPE_MAG 2     ; 魔法
#DEFINE SHAPE_DEF 3     ; 防禦
#DEFINE SHAPE_SPEC 4    ; 特殊

; Attribute：只用於臨時 Buff 判定
#DEFINE ATTR_FIRE 1     ; 火
#DEFINE ATTR_WATER 2    ; 水
#DEFINE ATTR_WIND 3     ; 風
#DEFINE ATTR_EARTH 4    ; 土

; 房間槽位 -> NPC 編號（空槽 = -1）
#DEFINE ROOM_OWNER_MAX 100
#DIM SAVEDATA ROOM_OWNER, 100

; 戰前隊伍編組（空槽 = -1）
#DIM SAVEDATA PARTY_MEMBERS, 4

