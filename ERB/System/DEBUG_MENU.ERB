; 職責：開發者除錯選單與測試功能集中管理。
@DEBUG_MAIN_MENU
$DEBUG_MAIN_TOP
DRAWLINE
PRINTL 【開發者選項 Debug Mode】
PRINTFORML 資源：金錢 {FLAG:RES_MONEY} / 材料 {FLAG:RES_MATERIAL} / 補給 {FLAG:RES_SUPPLY}
PRINTL [1] 資源修改
PRINTL [2] 產生隨機 NPC
PRINTL [3] NPC 編輯器
PRINTL [4] 口上測試器
PRINTL [0] 返回基地選單
INPUT RESULT

IF RESULT == 0
    RETURN
ENDIF
IF RESULT == 1
    CALL DEBUG_RESOURCE_MENU
    GOTO DEBUG_MAIN_TOP
ENDIF
IF RESULT == 2
    CALL TEST_ADD_RANDOM_NPC
    GOTO DEBUG_MAIN_TOP
ENDIF
IF RESULT == 3
    CALL DEBUG_NPC_EDITOR
    GOTO DEBUG_MAIN_TOP
ENDIF
IF RESULT == 4
    CALL DEBUG_KOJO_MENU
    GOTO DEBUG_MAIN_TOP
ENDIF

PRINTL 請輸入 0/1/2/3/4。
GOTO DEBUG_MAIN_TOP

@DEBUG_RESOURCE_MENU
$DEBUG_RESOURCE_TOP
DRAWLINE
PRINTL 【資源修改】
PRINTFORML 目前：金錢 {FLAG:RES_MONEY} / 材料 {FLAG:RES_MATERIAL} / 補給 {FLAG:RES_SUPPLY}
PRINTL [1] 金錢
PRINTL [2] 材料
PRINTL [3] 補給
PRINTL [0] 返回
INPUT RESULT

IF RESULT == 0
    RETURN
ENDIF
IF RESULT < 1 || RESULT > 3
    PRINTL 請輸入 0~3。
    GOTO DEBUG_RESOURCE_TOP
ENDIF

LOCAL:0 = RESULT
PRINTL [1] 增加（可輸入負數）
PRINTL [2] 直接設定
PRINTL [0] 取消
INPUT RESULT
LOCAL:1 = RESULT
IF LOCAL:1 == 0
    GOTO DEBUG_RESOURCE_TOP
ENDIF
IF LOCAL:1 != 1 && LOCAL:1 != 2
    PRINTL 請輸入 0/1/2。
    GOTO DEBUG_RESOURCE_TOP
ENDIF

PRINTL 請輸入數值：
INPUT RESULT
LOCAL:2 = RESULT

IF LOCAL:0 == 1
    IF LOCAL:1 == 1
        FLAG:RES_MONEY += LOCAL:2
    ELSE
        FLAG:RES_MONEY = LOCAL:2
    ENDIF
    IF FLAG:RES_MONEY < 0
        FLAG:RES_MONEY = 0
    ENDIF
ELSEIF LOCAL:0 == 2
    IF LOCAL:1 == 1
        FLAG:RES_MATERIAL += LOCAL:2
    ELSE
        FLAG:RES_MATERIAL = LOCAL:2
    ENDIF
    IF FLAG:RES_MATERIAL < 0
        FLAG:RES_MATERIAL = 0
    ENDIF
ELSE
    IF LOCAL:1 == 1
        FLAG:RES_SUPPLY += LOCAL:2
    ELSE
        FLAG:RES_SUPPLY = LOCAL:2
    ENDIF
    IF FLAG:RES_SUPPLY < 0
        FLAG:RES_SUPPLY = 0
    ENDIF
ENDIF

PRINTFORML 修改完成：金錢 {FLAG:RES_MONEY} / 材料 {FLAG:RES_MATERIAL} / 補給 {FLAG:RES_SUPPLY}
GOTO DEBUG_RESOURCE_TOP

@DEBUG_NPC_EDITOR
$DEBUG_NPC_EDITOR_TOP
DRAWLINE
PRINTL 【NPC 編輯器】
IF CHARANUM <= 1
    PRINTL 目前沒有可編輯的 NPC。
    RETURN
ENDIF

FOR LOCAL, 1, CHARANUM
    CALL GET_RACE_STR, CFLAG:(LOCAL):CF_RACE
    CALL GET_JOB_STR, CFLAG:(LOCAL):CF_JOB
    PRINTFORML [{LOCAL}] %CALLNAME:(LOCAL)% [%RESULTS:0% / %RESULTS:1%] | SPD {BASE:(LOCAL):BTL_SPEED} / CRIT {BASE:(LOCAL):BTL_CRIT}
NEXT
PRINTL [0] 返回
INPUT RESULT

IF RESULT == 0
    RETURN
ENDIF
IF RESULT < 1 || RESULT >= CHARANUM
    PRINTL 請輸入有效 NPC 編號。
    GOTO DEBUG_NPC_EDITOR_TOP
ENDIF

CALL DEBUG_NPC_EDITOR_DETAIL, RESULT
GOTO DEBUG_NPC_EDITOR_TOP

@DEBUG_NPC_EDITOR_DETAIL, ARG
$DEBUG_NPC_DETAIL_TOP
TARGET = ARG
CALL GET_RACE_STR, CFLAG:TARGET:CF_RACE
CALL GET_JOB_STR, CFLAG:TARGET:CF_JOB
DRAWLINE
PRINTFORML 【NPC 編輯：%CALLNAME:TARGET%】
PRINTFORML 種族/職業：%RESULTS:0% / %RESULTS:1%
PRINTFORML BASE：SPD {BASE:TARGET:BTL_SPEED} / CRIT {BASE:TARGET:BTL_CRIT} / PATK {BASE:TARGET:BTL_PATK} / MATK {BASE:TARGET:BTL_MATK} / SATK {BASE:TARGET:BTL_SATK} / PDEF {BASE:TARGET:BTL_PDEF} / MDEF {BASE:TARGET:BTL_MDEF}
PRINTFORML 狀態：心情 {CFLAG:TARGET:CF_MOOD} / 疲勞 {CFLAG:TARGET:CF_FATIGUE} / 好感 {CFLAG:TARGET:CF_BOND_LV}
PRINTL [1] 修改種族與職業（自動重算）
PRINTL [2] 手動修改 BASE
PRINTL [3] 修改心情
PRINTL [4] 修改疲勞
PRINTL [5] 修改好感
PRINTL [0] 返回
INPUT RESULT

IF RESULT == 0
    RETURN
ENDIF
IF RESULT == 1
    PRINTL 請輸入種族 ID（1~8）：
    INPUT RESULT
    LOCAL:0 = RESULT
    PRINTL 請輸入職業 ID（1~8）：
    INPUT RESULT
    LOCAL:1 = RESULT
    CFLAG:TARGET:CF_RACE = LIMIT(LOCAL:0, 1, 8)
    CFLAG:TARGET:CF_JOB = LIMIT(LOCAL:1, 1, 8)
    CALL INIT_CHARA_STATS, TARGET
    PRINTL 已更新種族/職業並重新計算 BASE。
    GOTO DEBUG_NPC_DETAIL_TOP
ENDIF
IF RESULT == 2
    CALL DEBUG_NPC_EDIT_BASE, TARGET
    GOTO DEBUG_NPC_DETAIL_TOP
ENDIF
IF RESULT == 3
    PRINTL 請輸入心情（0~100）：
    INPUT RESULT
    CFLAG:TARGET:CF_MOOD = LIMIT(RESULT, 0, 100)
    GOTO DEBUG_NPC_DETAIL_TOP
ENDIF
IF RESULT == 4
    PRINTL 請輸入疲勞（0~100）：
    INPUT RESULT
    CFLAG:TARGET:CF_FATIGUE = LIMIT(RESULT, 0, 100)
    GOTO DEBUG_NPC_DETAIL_TOP
ENDIF
IF RESULT == 5
    PRINTL 請輸入好感（0~10）：
    INPUT RESULT
    CFLAG:TARGET:CF_BOND_LV = LIMIT(RESULT, 0, 10)
    GOTO DEBUG_NPC_DETAIL_TOP
ENDIF

PRINTL 請輸入 0/1/2/3/4/5。
GOTO DEBUG_NPC_DETAIL_TOP

@DEBUG_NPC_EDIT_BASE, ARG
$DEBUG_NPC_BASE_TOP
TARGET = ARG
DRAWLINE
PRINTFORML 【手動修改 BASE：%CALLNAME:TARGET%】
PRINTFORML [1] 速度 {BASE:TARGET:BTL_SPEED}
PRINTFORML [2] 暴擊 {BASE:TARGET:BTL_CRIT}
PRINTFORML [3] 物攻 {BASE:TARGET:BTL_PATK}
PRINTFORML [4] 魔攻 {BASE:TARGET:BTL_MATK}
PRINTFORML [5] 特攻 {BASE:TARGET:BTL_SATK}
PRINTFORML [6] 物防 {BASE:TARGET:BTL_PDEF}
PRINTFORML [7] 魔防 {BASE:TARGET:BTL_MDEF}
PRINTL [0] 返回
INPUT RESULT
LOCAL:3 = RESULT

IF RESULT == 0
    RETURN
ENDIF
IF RESULT < 1 || RESULT > 7
    PRINTL 請輸入 0~7。
    GOTO DEBUG_NPC_BASE_TOP
ENDIF

PRINTL [1] 增加（可輸入負數）
PRINTL [2] 直接設定
INPUT RESULT
LOCAL:0 = RESULT
IF LOCAL:0 != 1 && LOCAL:0 != 2
    PRINTL 請輸入 1 或 2。
    GOTO DEBUG_NPC_BASE_TOP
ENDIF

PRINTL 請輸入數值：
INPUT RESULT
LOCAL:1 = RESULT

LOCAL:2 = BTL_SPEED
IF LOCAL:3 == 2
    LOCAL:2 = BTL_CRIT
ELSEIF LOCAL:3 == 3
    LOCAL:2 = BTL_PATK
ELSEIF LOCAL:3 == 4
    LOCAL:2 = BTL_MATK
ELSEIF LOCAL:3 == 5
    LOCAL:2 = BTL_SATK
ELSEIF LOCAL:3 == 6
    LOCAL:2 = BTL_PDEF
ELSEIF LOCAL:3 == 7
    LOCAL:2 = BTL_MDEF
ENDIF

IF LOCAL:0 == 1
    BASE:TARGET:(LOCAL:2) += LOCAL:1
ELSE
    BASE:TARGET:(LOCAL:2) = LOCAL:1
ENDIF
IF BASE:TARGET:(LOCAL:2) < 0
    BASE:TARGET:(LOCAL:2) = 0
ENDIF

PRINTL BASE 已更新。
GOTO DEBUG_NPC_BASE_TOP

@TEST_ADD_RANDOM_NPC
LOCAL:10 = 1 + RAND:2
ADDCHARA LOCAL:10

IF CHARANUM <= 1
    PRINTL 新角色加入失敗（未偵測到可用角色）。
    RETURN
ENDIF

LOCAL:11 = CHARANUM - 1
CFLAG:(LOCAL:11):CF_IS_RESIDENT = 0
CFLAG:(LOCAL:11):CF_ROOM_SLOT = 9999
CFLAG:(LOCAL:11):CF_RACE = 1 + RAND:8
CFLAG:(LOCAL:11):CF_JOB = 1 + RAND:8
CALL INIT_CHARA_STATS, LOCAL:11
CALL GET_RACE_STR, CFLAG:(LOCAL:11):CF_RACE
CALL GET_JOB_STR, CFLAG:(LOCAL:11):CF_JOB
PRINTFORML %CALLNAME:(LOCAL:11)% 已加入基地（%RESULTS:0% / %RESULTS:1%）。
RETURN


@DEBUG_BATTLE_MENU
$DEBUG_BATTLE_TOP
DRAWLINE
PRINTL 【戰鬥開發者選項 Debug】
PRINTFORML 主角 HP {BASE:MASTER:BTL_HP}/{BASE:MASTER:BTL_MAXHP} | EN {BASE:MASTER:BTL_EN}/{BASE:MASTER:BTL_MAXEN}
IF TFLAG:BATTLE_TARGET >= 0 && TFLAG:BATTLE_TARGET < CHARANUM
    PRINTFORML 目標：%CALLNAME:(TFLAG:BATTLE_TARGET)% HP {BASE:(TFLAG:BATTLE_TARGET):BTL_HP}/{BASE:(TFLAG:BATTLE_TARGET):BTL_MAXHP}
ELSE
    PRINTL 目標：無有效敵人
ENDIF
PRINTL [1] 主角 HP/EN 全滿
PRINTL [2] 秒殺當前敵人
PRINTL [0] 返回戰鬥
INPUT RESULT

IF RESULT == 0
    RETURN 0
ENDIF
IF RESULT == 1
    BASE:MASTER:BTL_HP = BASE:MASTER:BTL_MAXHP
    BASE:MASTER:BTL_EN = BASE:MASTER:BTL_MAXEN
    PRINTL 已將主角 HP/EN 回滿。
    GOTO DEBUG_BATTLE_TOP
ENDIF
IF RESULT == 2
    IF TFLAG:BATTLE_TARGET < 0 || TFLAG:BATTLE_TARGET >= CHARANUM
        PRINTL 當前沒有可處理的敵人。
        GOTO DEBUG_BATTLE_TOP
    ENDIF
    BASE:(TFLAG:BATTLE_TARGET):BTL_HP = 0
    PRINTL 已將當前敵人的 HP 歸零。
    RETURN 1
ENDIF

PRINTL 請輸入 0/1/2。
GOTO DEBUG_BATTLE_TOP

; ============================================================
; @DEBUG_KOJO_MENU — 口上測試器入口
; 列出所有 NPC，選擇後進入觸發選單
; 符合 Kojo_Standard.md MVP 「晨間問候可強制觸發」要求
; ============================================================

@DEBUG_KOJO_MENU
$DEBUG_KOJO_TOP
DRAWLINE
PRINTL 【口上測試器】
IF CHARANUM <= 1
    PRINTL 目前沒有可測試的 NPC（CHARANUM <= 1）。
    RETURN
ENDIF
FOR LOCAL, 1, CHARANUM
    PRINTFORML [{LOCAL}] %CALLNAME:(LOCAL)%（好感 {CFLAG:(LOCAL):CF_BOND_LV} / 疲勞 {CFLAG:(LOCAL):CF_FATIGUE} / 心情 {CFLAG:(LOCAL):CF_MOOD}）
NEXT
PRINTL [0] 返回
INPUT RESULT

IF RESULT == 0
    RETURN
ENDIF
IF RESULT < 1 || RESULT >= CHARANUM
    PRINTL 請輸入有效 NPC 編號。
    GOTO DEBUG_KOJO_TOP
ENDIF

CALL DEBUG_KOJO_TRIGGER, RESULT
GOTO DEBUG_KOJO_TOP

; ============================================================
; @DEBUG_KOJO_TRIGGER — 口上強制觸發選單
; ARG = NPC Chara ID
; 觸發前重置防重入旗標，確保每次都能正常輸出
; ============================================================

@DEBUG_KOJO_TRIGGER, ARG
$DEBUG_KOJO_TRIGGER_TOP
TARGET = ARG
DRAWLINE
PRINTFORML 【口上強制觸發：%CALLNAME:TARGET%】
PRINTFORML 好感 LV {CFLAG:TARGET:CF_BOND_LV} | 淫慾 {CFLAG:TARGET:CF_LUST} | 心情 {CFLAG:TARGET:CF_MOOD} | 疲勞 {CFLAG:TARGET:CF_FATIGUE}
PRINTL [1] EVT 110 晨間問候
PRINTL [2] EVT 120 入住
PRINTL [3] EVT 121 撤離
PRINTL [4] EVT 210 互動結算（成功）
PRINTL [5] EVT 320 技能映射成功
PRINTL [6] EVT 350 戰鬥結束（勝）
PRINTL [7] EVT 350 戰鬥結束（敗）
PRINTL [0] 返回
INPUT RESULT

IF RESULT == 0
    RETURN
ENDIF

; 重置口上防重入旗標，確保強制觸發不被攔截
TFLAG:KOJO_LAST_EVT  = -1
TFLAG:KOJO_LAST_TURN = -1

DRAWLINE
SELECTCASE RESULT
    CASE 1
        CALL KOJO_MESSAGE, ARG, 110, FLAG:BASE_DAY, 0
    CASE 2
        CALL KOJO_MESSAGE, ARG, 120, 0, 0
    CASE 3
        CALL KOJO_MESSAGE, ARG, 121, 0, 0
    CASE 4
        CALL KOJO_MESSAGE, ARG, 210, 300, 1
    CASE 5
        CALL KOJO_MESSAGE, ARG, 320, 20001, 0
    CASE 6
        CALL KOJO_MESSAGE, ARG, 350, 1, 3
    CASE 7
        CALL KOJO_MESSAGE, ARG, 350, 0, 3
    CASEELSE
        PRINTL 無效的選項。
ENDSELECT

WAIT
GOTO DEBUG_KOJO_TRIGGER_TOP
