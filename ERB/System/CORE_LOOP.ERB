; 職責：每日流程狀態機（晨間、日間、晚間）與流程保底處理。
@GAME_LOOP
; ===== 每日主循環入口 =====
WHILE 1
    IF FLAG:DAY_PHASE == 1
        CALL PHASE_MORNING
    ELSEIF FLAG:DAY_PHASE == 2
        CALL PHASE_DAY
    ELSEIF FLAG:DAY_PHASE == 3
        CALL PHASE_NIGHT
    ELSE
        CALL SYS_RECOVER
    ENDIF
WEND
RETURN

@PHASE_MORNING
DRAWLINE
PRINTFORML 【第{FLAG:BASE_DAY}天／晨間】
CALL BASE_EVENT_MORNING
PRINTL [1] 開始日間
INPUT RESULT
IF RESULT == 1
    FLAG:DAY_PHASE = 2
ENDIF
RETURN

@PHASE_DAY
$PHASE_DAY_MENU
DRAWLINE
PRINTFORML 【第{FLAG:BASE_DAY}天／日間】
PRINTL [1] 基地管理
PRINTL [2] 進入戰鬥
PRINTL [9] 結束日間
INPUT RESULT

IF RESULT == 1
    CALL BASE_MENU
    GOTO PHASE_DAY_MENU
ELSEIF RESULT == 2
    TFLAG:RETURN_PHASE = 2
    CALL BATTLE_PREPARATION
    CALL BATTLE_SETTLEMENT_REPORT
    GOTO PHASE_DAY_MENU
ELSEIF RESULT == 9
    FLAG:DAY_PHASE = 3
ENDIF
RETURN

@PHASE_NIGHT
$PHASE_NIGHT_MENU
DRAWLINE
PRINTFORML 【第{FLAG:BASE_DAY}天／晚間】
PRINTL [1] 晚間行動
PRINTL [2] 進入戰鬥
PRINTL [9] 就寢
INPUT RESULT

IF RESULT == 1
    CALL NIGHT_ACTION_MENU
    GOTO PHASE_NIGHT_MENU
ELSEIF RESULT == 2
    TFLAG:RETURN_PHASE = 3
    CALL BATTLE_PREPARATION
    CALL BATTLE_SETTLEMENT_REPORT
    GOTO PHASE_NIGHT_MENU
ELSEIF RESULT == 9
    CALL CHARA_EVENT_NIGHT
    CALL BASE_EVENT_NIGHT
    CALL TRIGGER_NIGHT_EVENT

    ; 一天結束，推進到隔日晨間
    FLAG:BASE_DAY += 1
    FLAG:DAY_PHASE = 1
    TFLAG:MORNING_DONE = 0
ENDIF
RETURN

@SYS_RECOVER
PRINTL [警告] 偵測到非法 DAY_PHASE，已重置為晨間。
FLAG:DAY_PHASE = 1
RETURN


@NIGHT_ACTION_MENU
$NIGHT_ACTION_TOP
DRAWLINE
PRINTL 【晚間行動】
PRINTFORML 補給：{FLAG:RES_SUPPLY}　金錢：{FLAG:RES_MONEY}　材料：{FLAG:RES_MATERIAL}
PRINTL [1] 夜間巡邏（消耗補給 5，獲得材料 +10）
PRINTL [2] 深度休息（全體住宿 NPC 疲勞 -20 / 心情 +5）
PRINTL [9] 返回晚間選單
INPUT RESULT

IF RESULT == 9
    RETURN
ELSEIF RESULT == 1
    CALL NIGHT_PATROL
    GOTO NIGHT_ACTION_TOP
ELSEIF RESULT == 2
    CALL NIGHT_REST
    GOTO NIGHT_ACTION_TOP
ELSE
    PRINTL 請輸入 1、2 或 9。
    GOTO NIGHT_ACTION_TOP
ENDIF
RETURN

@NIGHT_PATROL
IF FLAG:RES_SUPPLY < 5
    PRINTL [巡邏] 補給不足（需要 5），無法執行夜間巡邏。
    WAIT
    RETURN
ENDIF

FLAG:RES_SUPPLY -= 5
IF FLAG:RES_SUPPLY < 0
    FLAG:RES_SUPPLY = 0
ENDIF

FLAG:RES_MATERIAL += 10
IF FLAG:RES_MATERIAL > 9999
    FLAG:RES_MATERIAL = 9999
ENDIF

PRINTFORML [巡邏完成] 補給 -5 / 材料 +10（現有：補給 {FLAG:RES_SUPPLY} / 材料 {FLAG:RES_MATERIAL}）
WAIT
RETURN

@NIGHT_REST
LOCAL:10 = FLAG:BASE_FAC_LV_ROOM
IF LOCAL:10 < 0
    LOCAL:10 = 0
ELSEIF LOCAL:10 > ROOM_OWNER_MAX
    LOCAL:10 = ROOM_OWNER_MAX
ENDIF

LOCAL:11 = 0
FOR LOCAL, 0, LOCAL:10
    IF ROOM_OWNER:LOCAL == -1
        CONTINUE
    ENDIF

    LOCAL:1 = ROOM_OWNER:LOCAL
    CFLAG:(LOCAL:1):CF_FATIGUE -= 20
    IF CFLAG:(LOCAL:1):CF_FATIGUE < 0
        CFLAG:(LOCAL:1):CF_FATIGUE = 0
    ENDIF
    CFLAG:(LOCAL:1):CF_MOOD += 5
    IF CFLAG:(LOCAL:1):CF_MOOD > 100
        CFLAG:(LOCAL:1):CF_MOOD = 100
    ENDIF
    LOCAL:11 += 1
NEXT

IF LOCAL:11 == 0
    PRINTL [深度休息] 目前沒有住宿 NPC。
ELSE
    PRINTFORML [深度休息] {LOCAL:11} 名 NPC 疲勞 -20 / 心情 +5。
ENDIF
WAIT
RETURN

@TRIGGER_NIGHT_EVENT
; 事件類別基礎權重：資源 30 / 基地 20 / NPC 20 / 無事（固定） 30
; 冷卻中的類別權重歸零；總有效權重為 0 時本夜略過
LOCAL:10 = 30
LOCAL:11 = 20
LOCAL:12 = 20
IF TFLAG:EVT_COOLDOWN_RES > 0
    LOCAL:10 = 0
ENDIF
IF TFLAG:EVT_COOLDOWN_BASE > 0
    LOCAL:11 = 0
ENDIF
IF TFLAG:EVT_COOLDOWN_NPC > 0
    LOCAL:12 = 0
ENDIF

; 無住宿 NPC 時 NPC 事件不可觸發
LOCAL:8 = FLAG:BASE_FAC_LV_ROOM
IF LOCAL:8 < 0
    LOCAL:8 = 0
ELSEIF LOCAL:8 > ROOM_OWNER_MAX
    LOCAL:8 = ROOM_OWNER_MAX
ENDIF
LOCAL:9 = 0
FOR LOCAL, 0, LOCAL:8
    IF ROOM_OWNER:LOCAL != -1
        LOCAL:9 += 1
    ENDIF
NEXT
IF LOCAL:9 == 0
    LOCAL:12 = 0
ENDIF

LOCAL:13 = LOCAL:10 + LOCAL:11 + LOCAL:12
IF LOCAL:13 == 0
    RETURN
ENDIF

; 擲骰：上界 = 有效事件權重 + 無事固定權重 30
LOCAL = RAND:(LOCAL:13 + 30)
IF LOCAL >= LOCAL:13
    RETURN
ENDIF

IF LOCAL < LOCAL:10
    CALL NIGHT_EVENT_RESOURCE
    TFLAG:EVT_COOLDOWN_RES = 2
ELSEIF LOCAL < LOCAL:10 + LOCAL:11
    CALL NIGHT_EVENT_BASE
    TFLAG:EVT_COOLDOWN_BASE = 2
ELSE
    CALL NIGHT_EVENT_NPC
    TFLAG:EVT_COOLDOWN_NPC = 2
ENDIF
RETURN

@NIGHT_EVENT_RESOURCE
PRINTL
PRINTL ══════════════════════════════
PRINTL 【晚間事件：資源發現】
LOCAL = RAND:3
IF LOCAL == 0
    LOCAL:1 = 50 + RAND:100
    FLAG:RES_MONEY += LOCAL:1
    IF FLAG:RES_MONEY > 999999
        FLAG:RES_MONEY = 999999
    ENDIF
    PRINTFORML  在基地角落發現了遺落的物資！獲得金錢 +{LOCAL:1}
ELSEIF LOCAL == 1
    LOCAL:1 = 10 + RAND:10
    FLAG:RES_MATERIAL += LOCAL:1
    IF FLAG:RES_MATERIAL > 9999
        FLAG:RES_MATERIAL = 9999
    ENDIF
    PRINTFORML  發現一批廢棄材料！獲得材料 +{LOCAL:1}
ELSE
    LOCAL:1 = 5 + RAND:5
    FLAG:RES_SUPPLY += LOCAL:1
    IF FLAG:RES_SUPPLY > 9999
        FLAG:RES_SUPPLY = 9999
    ENDIF
    PRINTFORML  有人送來了不明補給！獲得補給 +{LOCAL:1}
ENDIF
PRINTL ══════════════════════════════
WAIT
RETURN

@NIGHT_EVENT_BASE
PRINTL
PRINTL ══════════════════════════════
PRINTL 【晚間事件：基地異動】
LOCAL:10 = RAND:2
LOCAL:1 = 0
LOCAL:2 = -1
IF LOCAL:10 == 0
    ; 工坊捷徑：縮短最早一個進行中生產槽的剩餘天數
    FOR LOCAL, 0, WORK_Q_MAX
        IF WORK_Q_REMAIN:LOCAL > 0 && LOCAL:1 == 0
            WORK_Q_REMAIN:LOCAL -= 1
            IF WORK_Q_REMAIN:LOCAL < 0
                WORK_Q_REMAIN:LOCAL = 0
            ENDIF
            LOCAL:2 = LOCAL
            LOCAL:1 = 1
        ENDIF
    NEXT
    IF LOCAL:1 == 1
        PRINTFORML  工坊的工匠找到了新捷徑！生產槽位{LOCAL:2} 提前完成一天。
    ELSE
        PRINTL  工坊的工匠進行了日常維護，基地狀態良好。
    ENDIF
ELSE
    ; 匿名資助
    LOCAL:3 = 80 + RAND:60
    FLAG:RES_MONEY += LOCAL:3
    IF FLAG:RES_MONEY > 999999
        FLAG:RES_MONEY = 999999
    ENDIF
    PRINTFORML  基地收到了不知名的資助！獲得金錢 +{LOCAL:3}
ENDIF
PRINTL ══════════════════════════════
WAIT
RETURN

@NIGHT_EVENT_NPC
LOCAL:20 = FLAG:BASE_FAC_LV_ROOM
IF LOCAL:20 < 0
    LOCAL:20 = 0
ELSEIF LOCAL:20 > ROOM_OWNER_MAX
    LOCAL:20 = ROOM_OWNER_MAX
ENDIF

; 統計住宿人數
LOCAL:21 = 0
FOR LOCAL, 0, LOCAL:20
    IF ROOM_OWNER:LOCAL != -1
        LOCAL:21 += 1
    ENDIF
NEXT
IF LOCAL:21 == 0
    RETURN
ENDIF

; 隨機選出第 N 個有效住宿 NPC
LOCAL:22 = RAND:LOCAL:21
LOCAL:23 = 0
LOCAL:24 = -1
FOR LOCAL, 0, LOCAL:20
    IF ROOM_OWNER:LOCAL == -1
        CONTINUE
    ENDIF
    IF LOCAL:23 == LOCAL:22 && LOCAL:24 == -1
        LOCAL:24 = ROOM_OWNER:LOCAL
    ENDIF
    LOCAL:23 += 1
NEXT
IF LOCAL:24 == -1
    RETURN
ENDIF

TARGET = LOCAL:24
PRINTL
PRINTL ══════════════════════════════
PRINTL 【晚間事件：NPC 動態】
LOCAL = RAND:2
IF LOCAL == 0
    CFLAG:TARGET:CF_MOOD += 10
    IF CFLAG:TARGET:CF_MOOD > 100
        CFLAG:TARGET:CF_MOOD = 100
    ENDIF
    CFLAG:TARGET:CF_FATIGUE -= 10
    IF CFLAG:TARGET:CF_FATIGUE < 0
        CFLAG:TARGET:CF_FATIGUE = 0
    ENDIF
    PRINTFORML  [%CALLNAME:TARGET%] 自發整理了基地裝備，狀態有所改善。
    PRINTFORML  （心情 {CFLAG:TARGET:CF_MOOD} / 疲勞 {CFLAG:TARGET:CF_FATIGUE}）
ELSE
    CFLAG:TARGET:CF_MOOD -= 5
    IF CFLAG:TARGET:CF_MOOD < 0
        CFLAG:TARGET:CF_MOOD = 0
    ENDIF
    PRINTFORML  [%CALLNAME:TARGET%] 似乎遇到了些煩惱，心情略有低落。
    PRINTFORML  （心情 {CFLAG:TARGET:CF_MOOD}）
ENDIF
PRINTL ══════════════════════════════
WAIT
RETURN
